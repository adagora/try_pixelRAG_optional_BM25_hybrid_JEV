.DS_Store
.env
.venv/
.venv_encoder/
*.pyc
__pycache__/

# source PDFs (large; tiles/embeddings are what chat needs)
pdfs/

# build leftovers inside index (final shard + faiss are enough)
index/_probe/
index/embeddings/partial_*.npz
index/embeddings/checkpoint.json

# derived caches — regenerated on demand, and the answer cache is keyed to a
# specific index build, so it is meaningless on another machine
index/tiles/_fit/
index/answer_cache.npz
index/answer_cache.json
index/transcripts/

# service logs (serve_all.py)
logs/
logs_serveall.log
undefined/
